# Copy this file to .env and replace the example values. Do not commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONNECT_URL=http://localhost:8083

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=essentials
MYSQL_USER=telecom_app
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_JDBC_URL=jdbc:mysql://localhost:3306/essentials?useSSL=false&allowPublicKeyRetrieval=true

HDFS_URL=hdfs://localhost:9000
